<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Flee</AssemblyName>
        <AssemblyTitle>Flee</AssemblyTitle>
        <Description>Flee (Fast Lightweight Expression Evaluator) parses expressions such as sqrt(a^2 + b^2) at runtime and compiles them to IL. Maintained fork of mparlak/Flee.</Description>
        <Product>Flee</Product>
        <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
        <!-- Several target frameworks: keep one output folder per framework
             (Directory.Build.props turns this off for single-target projects). -->
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <IsMainAssembly>true</IsMainAssembly>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Flee</Title>
        <PackageProjectUrl>https://github.com/klopsquark/Flee</PackageProjectUrl>
        <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>flee,expression evaluator,Expression Evaluator for c#</PackageTags>
        <!-- Symbols as a separate .snupkg; Source Link (built into the SDK) points the PDBs at the
             repository, so debuggers can fetch the sources. -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- The benchmark project measures the parse stage on its own, which needs internals. -->
        <InternalsVisibleTo Include="Flee.Benchmarks" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\DocComments.xml" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Resources\DocComments.xml" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GitVersion.MsBuild" Version="6.4.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- netstandard2.0 lacks Reflection.Emit; every other target has it built in. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
        <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.7.0" />
        <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
    </ItemGroup>

</Project>
