<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- net6.0 is the baseline runtime (the newest target of upstream Flee 2.0.0).
             Phase 3 adds the new runtime so both can be compared with one project. -->
        <TargetFramework>net6.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- BenchmarkDotNet needs optimized code and complains about a debugger. -->
        <Optimize>true</Optimize>
        <DebugType>pdbonly</DebugType>
        <IsExperimentOnly>true</IsExperimentOnly>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Flee\Flee.csproj" />
    </ItemGroup>

</Project>
