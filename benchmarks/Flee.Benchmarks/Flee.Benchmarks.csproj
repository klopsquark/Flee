<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- net6.0 is the baseline runtime (the newest target of upstream Flee 2.0.0); there Flee
             comes from its netstandard2.1 build. net8.0 and net10.0 are the current targets.
             benchmarks/README.md shows how to run one runtime or several. -->
        <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <!-- net6.0 is kept on purpose as the baseline runtime; silence the packages' warnings that
             they no longer support it. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- BenchmarkDotNet needs optimized code and complains about a debugger. -->
        <Optimize>true</Optimize>
        <DebugType>pdbonly</DebugType>
        <IsExperimentOnly>true</IsExperimentOnly>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Flee\Flee.csproj" />
    </ItemGroup>

</Project>
