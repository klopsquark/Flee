<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <!-- Two frameworks: keep one output folder per framework (Directory.Build.props turns
             this off for single-target projects). -->
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
        <PackageReference Include="coverlet.collector" Version="10.1.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Flee\Flee.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- The script tests read these from the output folder. -->
      <None Update="TestScripts\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
