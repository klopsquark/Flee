<Project>

    <PropertyGroup>
        <!-- Explicit, so every project gets the same language level regardless
             of its target framework's default. -->
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Directory.Build.props is evaluated BEFORE the SDK defaults
             Configuration, so building a .csproj directly (rather than via the
             .sln, which passes Configuration explicitly) would otherwise
             resolve Configuration-dependent paths without a Debug/Release
             segment. Default it here so both routes agree. -->
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

        <!-- Centralize all output to a single directory. Projects that build
             several target frameworks must set AppendTargetFrameworkToOutputPath
             back to true, or the frameworks overwrite each other's output. -->
        <BaseOutputPath>$(MSBuildThisFileDirectory)build\$(MSBuildProjectName)\</BaseOutputPath>
        <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <!-- NuGet packaging: packages land in the maintainer's local feed
             when it exists on this machine, else under build/nuget/; pass
             /p:PackageOutputPath=... to override either. -->
        <PackageOutputPath Condition="'$(PackageOutputPath)' == '' AND Exists('C:\dev\nuget')">C:\dev\nuget\</PackageOutputPath>
        <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildThisFileDirectory)build\nuget\</PackageOutputPath>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

</Project>
